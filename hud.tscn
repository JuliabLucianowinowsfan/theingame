[sub_resource type="GDScript" id="GDScript_64ctp"]
resource_name = "android_offset"
script/source = "extends Control

func _ready():
	if OS.has_feature(\"android\"):
		var margin := 172
		var scrsize := get_viewport().get_visible_rect().size
		
		position.x = scrsize.x - size.x - margin
		position.y = 100
"

