[sub_resource type="GDScript" id="GDScript_640wx"]
resource_name = "jump butt"
script/source = "extends TouchScreenButton

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _ready():
	var margin := 172
	var scrsize := get_viewport().get_visible_rect().size
	
	position.x = scrsize.x - 64 - margin
"

